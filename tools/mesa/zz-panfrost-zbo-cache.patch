 static void
 panfrost_bo_free(struct panfrost_bo *bo)
 {
+#ifdef __APPLE__
+   /* a BO from the cache keeps its mapping there (see panfrost_bo_unreference): given back when the BO is freed */
+   panfrost_bo_munmap(bo);
+#endif
    struct pan_kmod_bo *kmod_bo = bo->kmod_bo;
