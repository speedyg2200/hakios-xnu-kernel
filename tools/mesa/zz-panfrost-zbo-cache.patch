@@ -465,7 +473,14 @@
     */
    if (p_atomic_read(&bo->refcnt) == 0) {
       /* When the reference count goes to zero, we need to cleanup */
+#ifndef __APPLE__
       panfrost_bo_munmap(bo);
+#else
+      /* On Darwin a mapping is a round trip to the kernel each way (IOConnectMapMemory, and hakios_drm_unmap), and the
